{
  "name": "streampulse",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "StreamPulse — universal media streamer, downloader and admin control center.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "start:dev": "tsx server.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/utils/mediaParser.test.ts",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','dist-server']){try{fs.rmSync(p,{recursive:true,force:true})}catch{}}\"",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
